# examples/Fastfile — copy to fastlane/Fastfile and adapt.
# Replace YourApp.xcodeproj / scheme names. Auth setup: see env.example.
# Contains both macOS and iOS platforms — delete the block you don't need.
#
#   fastlane mac release   /  fastlane ios release
#   fastlane mac upload    /  fastlane ios upload
#   fastlane mac submit    /  fastlane ios submit

# ---------- shared ----------

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH", "fastlane/AuthKey.p8")
  )
end

SUBMISSION_INFO = {
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false  # when the app has no custom encryption
}.freeze

def deliver_common
  {
    precheck_include_in_app_purchases: false,  # API-key auth can't precheck IAPs
    force: true                                # skip the HTML preview prompt
  }
end

# ---------- macOS ----------

platform :mac do
  desc "Archive + upload the binary only"
  lane :upload do
    asc_key
    build
    upload_to_app_store(**deliver_common,
      platform: "osx",
      skip_metadata: true,
      skip_screenshots: true
    )
  end

  desc "Archive + upload + metadata + submit for review (auto-release)"
  lane :release do
    asc_key
    build
    upload_to_app_store(**deliver_common,
      platform: "osx",
      app_version: get_version_number(xcodeproj: "YourApp.xcodeproj", target: "YourApp"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: SUBMISSION_INFO
    )
  end

  desc "Screenshots + submit only, reusing the uploaded build"
  lane :submit do
    asc_key
    upload_to_app_store(**deliver_common,
      platform: "osx",
      app_version: get_version_number(xcodeproj: "YourApp.xcodeproj", target: "YourApp"),
      build_number: get_build_number(xcodeproj: "YourApp.xcodeproj"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: false,
      submit_for_review: true,
      automatic_release: true,
      submission_information: SUBMISSION_INFO
    )
  end

  private_lane :build do
    build_mac_app(
      project: "YourApp.xcodeproj",
      scheme: "YourApp",
      export_method: "app-store",
      output_directory: "fastlane/build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end
end

# ---------- iOS ----------

platform :ios do
  desc "Archive + upload the binary only"
  lane :upload do
    asc_key
    build
    upload_to_app_store(**deliver_common,
      platform: "ios",
      skip_metadata: true,
      skip_screenshots: true
    )
  end

  desc "Archive + upload + metadata + submit for review (auto-release)"
  lane :release do
    asc_key
    build
    upload_to_app_store(**deliver_common,
      platform: "ios",
      app_version: get_version_number(xcodeproj: "YourApp.xcodeproj", target: "YourApp"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: SUBMISSION_INFO
    )
  end

  desc "Screenshots + submit only, reusing the uploaded build"
  lane :submit do
    asc_key
    upload_to_app_store(**deliver_common,
      platform: "ios",
      app_version: get_version_number(xcodeproj: "YourApp.xcodeproj", target: "YourApp"),
      build_number: get_build_number(xcodeproj: "YourApp.xcodeproj"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: false,
      submit_for_review: true,
      automatic_release: true,
      submission_information: SUBMISSION_INFO
    )
  end

  desc "Upload a build to TestFlight"
  lane :beta do
    asc_key
    build
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  private_lane :build do
    build_app(
      project: "YourApp.xcodeproj",   # or workspace: "YourApp.xcworkspace"
      scheme: "YourApp",
      export_method: "app-store",
      output_directory: "fastlane/build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
  end
end
